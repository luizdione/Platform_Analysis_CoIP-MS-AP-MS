# =============================================================================
# bonder - ANALYSIS image (CPU): Python + R/Bioconductor (DEP/limma/MSstats)
# + SAINTexpress. Used by the 'web' and 'worker' services. Nothing is
# reimplemented: the gold-standard statistics run here via Rscript and
# SAINTexpress-int.
# =============================================================================
FROM mambaorg/micromamba:1.5.8

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates git curl unzip \
    && rm -rf /var/lib/apt/lists/*

# Reproducible conda environment (gold-standard tools: Python + R/Bioconductor)
COPY docker/environment-analysis.yml /tmp/env.yml
RUN micromamba install -y -n base -f /tmp/env.yml && micromamba clean -a -y
# /opt/bonder/bin on PATH: a hatch to mount a host SAINTexpress-int (volume)
# without rebuilding the image.
RUN mkdir -p /opt/bonder/bin
ENV PATH=/opt/bonder/bin:/opt/conda/bin:$PATH

# SAINTexpress: NOT available in conda. Compiled from source (SourceForge).
# BEST-EFFORT and NON-FATAL: if the download/build fails (e.g. no network), the
# image still builds and the SAINT stage is simply 'skipped' at runtime (the
# pipeline tolerates it). Official release (tar.gz), built with each subdir's
# 'compile' script, which uses g++ + GSL (libgsl-dev, installed above). It uses
# /usr/bin's g++ (not conda's) so it finds the system GSL headers.
# GSL goes in a late layer (so it does not invalidate the heavy R/conda layer).
RUN apt-get update && apt-get install -y --no-install-recommends libgsl-dev \
    && rm -rf /var/lib/apt/lists/*
ARG SAINT_URL="https://sourceforge.net/projects/saint-apms/files/SAINTexpress_v3.6.3__2018-03-09.tar.gz/download"
RUN set -x; ( \
      curl -fL -o /tmp/saint.tgz "$SAINT_URL" \
      && mkdir -p /tmp/saint && tar xzf /tmp/saint.tgz -C /tmp/saint \
      && for d in $(find /tmp/saint -type d \( -name 'SAINTexpress-int' -o -name 'SAINTexpress-spc' \)); do \
           ( cd "$d" && PATH=/usr/bin:$PATH sh -c 'if [ -f compile ]; then bash compile; else make; fi' ) || true; \
         done \
      && find /tmp/saint -type f \( -name 'SAINTexpress-int' -o -name 'SAINTexpress-spc' \) -perm -u+x -exec cp {} /usr/local/bin/ \; \
      && chmod +x /usr/local/bin/SAINTexpress-* \
      && rm -rf /tmp/saint /tmp/saint.tgz \
    ) || echo "WARNING: SAINTexpress was not installed automatically; the SAINT stage will be skipped (see docs/COMO_RODAR.md)."

WORKDIR /app
# Install the bonder package
COPY . /app
RUN pip install --no-deps -e . && python -c "import bonder; print('bonder', bonder.__version__)"

# Check R/Bioconductor (required) and report SAINTexpress (optional, non-fatal)
RUN Rscript -e 'stopifnot(requireNamespace("DEP"), requireNamespace("limma"))' \
    && (command -v SAINTexpress-int && echo "SAINTexpress OK" \
        || echo "AVISO: SAINTexpress-int ausente; etapa SAINT sera pulada em runtime.")

ENV BONDER_DATA_ROOT=/data BONDER_RUNS_DIR=/runs
EXPOSE 8080
# default: the web dashboard (overridden to 'worker' in the compose file)
CMD ["gunicorn", "-b", "0.0.0.0:8080", "-w", "2", "-t", "600", "bonder.web.app:create_app()"]
