# =============================================================================
# bonder - GPU image (optional): CUDA 12.4 + PyTorch cu124 + established deep
# learning tools. Used only for OPTIONAL stages accelerated on an NVIDIA GPU:
# DIA-NN (DIA search), MS2Rescore/AlphaPeptDeep (rescoring) and the exploratory
# ESM2 prioritisation. All of them have a CPU fallback in the code.
#
# Runtime (not devel): the torch wheels need no CUDA compiler.
# =============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip git ca-certificates \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-gpu.txt /app/
# torch cu124 + rescoring/embedding libraries
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -r requirements-gpu.txt \
       --extra-index-url https://download.pytorch.org/whl/cu124

COPY . /app
RUN pip install --no-deps -e .

# DIA-NN and ColabFold are NOT pip packages. To enable them, put the binaries on PATH:
#   - DIA-NN:    download the Linux release (accept its licence) and COPY it to /usr/local/bin/diann
#   - ColabFold: install colabfold_batch (localcolabfold) and expose it on PATH
# Example (uncomment and adjust the version/licence):
# COPY vendor/diann /usr/local/bin/diann

ENV BONDER_DATA_ROOT=/data BONDER_RUNS_DIR=/runs
# validate the device (must never fail; falls back to CPU with no GPU)
RUN python -c "from bonder.gpu.detect import probe; print(probe().to_dict())" || true
CMD ["python", "-c", "from bonder.gpu.detect import probe; print(probe().to_dict())"]
