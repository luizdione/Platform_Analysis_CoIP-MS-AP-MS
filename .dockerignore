# =============================================================================
# What NEVER goes into the container image.
# First of all: no experimental data, no project memory, no credentials.
# =============================================================================

# --- git and repository metadata ---
.git
.github
.gitignore

# --- local notes and working memory (not the product) ---
.project-memory/
*.local.md
NOTAS_*.md

# --- user data: inputs, downloaded databases and run outputs ---
data/
runs/
inputs/
outputs/
*.raw
*.mzML
*.mzml
*.d/
*.wiff
*.parquet
proteinGroups.txt
report.tsv
combined_protein.tsv

# --- bait sequences supplied by the user ---
config/sequences/*.fasta
*.fasta
*.fa

# --- credentials and local configuration (deploy tokens, keys, etc.) ---
.env
.env.*
.netrc
*.pem
*.key
*.crt
secrets/
.*credentials*
docker/docker-compose.local.yml

# --- caches and build artefacts ---
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info
build/
dist/
.venv
venv

# --- vendored external binaries (fetched at build time, not copied) ---
vendor/bin/*
!vendor/bin/.gitkeep

# --- heavy or irrelevant for the image ---
docs/*.pdf
*.zip
*.tar.gz
