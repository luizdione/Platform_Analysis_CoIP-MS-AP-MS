# bonder - local artefacts, not versioned
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# downloaded reference databases (large; reproduced by 'bonder db sync')
data/

# run outputs
runs/

# user inputs (search outputs, .raw)
inputs/
*.raw
*.mzML
*.d/

# bait sequences supplied by the user (never version private sequences)
config/sequences/*.fasta

# parquet / intermediate artefacts
*.parquet

# environments
.venv/
venv/
.env

# vendored external binaries (not versioned)
vendor/bin/*
!vendor/bin/.gitkeep

# user's local administrative documents (not versioned)
formularios/

# local notes and working memory: never version these in this repository
.project-memory/
*.local.md
NOTAS_*.md

# local credentials and tokens
.netrc
*.pem
*.key
secrets/
.*credentials*

# local docker override (paths on your own machine)
docker/docker-compose.local.yml
