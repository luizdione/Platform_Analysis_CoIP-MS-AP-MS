# Line-ending normalisation: the repository stores LF; checkout follows the OS.
* text=auto

# Files that run inside a Linux container: ALWAYS LF, including on a Windows
# clone (CRLF breaks the shebang and heredocs inside the image).
Dockerfile*     text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Makefile        text eol=lf
*.R             text eol=lf
*.cff           text eol=lf

# Windows scripts: CRLF.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Third-party libraries: do not touch (byte-for-byte, and the diff stays clean).
bonder/web/static/vendor/** -text -diff linguist-vendored

# Binaries.
*.png           binary
*.ico           binary
*.pdf           binary
*.gz            binary
*.zip           binary
*.raw           binary
